# PostHog Configuration
# Copy this file to .env and fill in your actual values
# Get your Project API Key from PostHog dashboard: Project Settings
EXPO_PUBLIC_POSTHOG_KEY=phc_your_project_api_key_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat iOS public API key (Project Settings → API Keys → iOS in RevenueCat).
# Format is appl_... for production; the test_... prefix is a sandbox key.
# Optional: if unset, app.config.js falls back to the key baked in there.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_revenuecat_ios_public_key_here
