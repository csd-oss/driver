# PostHog Configuration
# Copy this file to .env and fill in your actual values
# Get your Project API Key from PostHog dashboard: Project Settings
EXPO_PUBLIC_POSTHOG_KEY=phc_your_project_api_key_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat iOS public SDK key. appl_xxx is the App Store SDK key (production
# + real-device sandbox); test_xxx targets RevenueCat's synthetic Test Store
# (useful for simulator dev with no Apple sandbox account). app.config.js
# falls back to the appl_ key for this project if unset.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_revenuecat_ios_public_key_here
