# PostHog Configuration
# Copy this file to .env and fill in your actual values
# Get your Project API Key from PostHog dashboard: Project Settings
EXPO_PUBLIC_POSTHOG_KEY=phc_your_project_api_key_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Superwall iOS public API key (Settings → API Keys in Superwall dashboard).
# Optional: if unset, app.config.js falls back to the key baked in there.
EXPO_PUBLIC_SUPERWALL_IOS_KEY=pk_your_superwall_ios_public_key_here
